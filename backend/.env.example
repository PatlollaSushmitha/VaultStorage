# Server
PORT=3000

# Frontend origin allowed to call this API during development
FRONTEND_ORIGIN=http://localhost:5173

# PostgreSQL connection string
# Example: postgresql://postgres:postgres@localhost:5432/vault
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vault

# Default replication factor applied to new objects
DEFAULT_REPLICATION_FACTOR=3

# Root directory (relative to backend/) where node storage folders live
STORAGE_ROOT=storage
